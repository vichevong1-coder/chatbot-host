# API Keys
GEMINI_API_KEY=

# Services Ports (Shifted to 9000 series)
ORCHESTRATOR_PORT=9000
MATH_SERVICE_PORT=9001
SCIENCE_SERVICE_PORT=9002

# Downstream URLs (resolved within Docker network)
MATH_SERVICE_URL=http://math-service:9001
SCIENCE_SERVICE_URL=http://science-service:9002

# Cache & Vector Database (Stateful services)
REDIS_URL=redis://redis:6379/0
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Postgres Database Config
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=science_chatbot
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/science_chatbot
