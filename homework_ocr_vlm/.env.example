# Copy this to .env and fill in your values

# --- VLM Provider: choose "gemini" or "ollama" ---
VLM_PROVIDER=ollama
VLM_MODEL=gemma4:31b

# Gemini (used when VLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama remote (used when VLM_PROVIDER=ollama)
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_BASE_URL=https://ollama.com

MAX_IMAGE_LONG_SIDE=2000
OCR_CONFIDENCE_THRESHOLD=0.70
VLM_CONFIDENCE_THRESHOLD=0.75
LOW_CONFIDENCE_THRESHOLD=0.60

LAYOUT_LANG=en
ENABLE_KHMER=false

APP_HOST=0.0.0.0
APP_PORT=9003
DEBUG=false
